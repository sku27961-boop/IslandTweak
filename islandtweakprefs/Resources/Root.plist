			<key>key</key>
			<string>colorG</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>255</integer>
			<key>defaults</key>
			<string>com.example.islandtweak</string>
			<key>PostNotification</key>
			<string>com.example.islandtweak/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>青（B）</string>
			<key>key</key>
			<string>colorB</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>255</integer>
			<key>defaults</key>
			<string>com.example.islandtweak</string>
			<key>PostNotification</key>
			<string>com.example.islandtweak/reload</string>
		</dict>

