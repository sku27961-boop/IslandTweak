<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>IslandTweak</string>
	<key>items</key>
	<array>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>基本設定</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>有効にする</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.example.islandtweak</string>
			<key>PostNotification</key>
			<string>com.example.islandtweak/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>使ってない時は隠す</string>
			<key>key</key>
			<string>hideWhenIdle</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.example.islandtweak</string>
			<key>PostNotification</key>
			<string>com.example.islandtweak/reload</string>
